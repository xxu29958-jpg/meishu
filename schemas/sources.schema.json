{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract_version": {
      "const": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
          },
          "author": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "enum": [
              "procedural-original",
              "handmade-original",
              "ai-generated-original",
              "public-domain",
              "licensed-reference"
            ]
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "references": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "editable_files": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "author",
          "method",
          "license",
          "description",
          "references",
          "editable_files"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "contract_version",
    "sources"
  ],
  "additionalProperties": false
}
