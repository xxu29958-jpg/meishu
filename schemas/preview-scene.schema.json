{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract_version": {
      "const": 1
    },
    "canvas_size": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 4096
      },
      "minItems": 2,
      "maxItems": 2
    },
    "origin": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "hex": {
      "type": "object",
      "properties": {
        "step": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        },
        "odd_row_offset": {
          "type": "number"
        }
      },
      "additionalProperties": false,
      "required": [
        "step",
        "odd_row_offset"
      ]
    },
    "tiles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "row": {
            "type": "integer",
            "minimum": 0
          },
          "column": {
            "type": "integer",
            "minimum": 0
          },
          "asset": {
            "type": "string",
            "minLength": 1
          },
          "clip": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "row",
          "column",
          "asset",
          "clip"
        ]
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "asset": {
            "type": "string",
            "minLength": 1
          },
          "clip": {
            "type": "string",
            "minLength": 1
          },
          "position": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "scale": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "additionalProperties": false,
        "required": [
          "asset",
          "clip",
          "position",
          "scale"
        ]
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "contract_version",
    "canvas_size",
    "origin",
    "hex",
    "tiles",
    "items"
  ]
}
